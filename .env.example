# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase.
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Usa SOLO la clave pública "anon" / "publishable". NUNCA la service_role en el frontend.
VITE_SUPABASE_ANON_KEY=tu-clave-publica-anon
